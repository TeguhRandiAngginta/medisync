<file path="app/Http/Controllers/SalesHistoryController.php">
<?php

namespace App\Http\Controllers;

use App\Models\Sale;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Inertia\Inertia;

class SalesHistoryController extends Controller
{

    private function authorizeAdmin(): void
    {
        $user = auth()->user();
        if (!$user || !in_array($user->role, ['admin', 'owner', 'superadmin'])) {
            abort(403, 'Anda tidak memiliki hak akses untuk melakukan tindakan ini.');
        }
    }

    public function index()
    {
        $sales = Sale::with(['details.medicine', 'user'])
                    ->latest()
                    ->paginate(15);

        return Inertia::render('Sales/Index', [
            'sales' => $sales,
            'isTrash' => false
        ]);
    }

    public function trash()
    {
        $this->authorizeAdmin();

        $sales = Sale::onlyTrashed()
                    ->with(['details.medicine', 'user'])
                    ->latest('deleted_at')
                    ->paginate(15);

        return Inertia::render('Sales/Index', [
            'sales' => $sales,
            'isTrash' => true
        ]);
    }

    public function destroy($id)
    {
        $this->authorizeAdmin();

        DB::transaction(function () use ($id) {
            $sale = Sale::findOrFail($id);
            $sale->delete();
        });

        return redirect()->back()->with('success', 'Riwayat penjualan berhasil dipindahkan ke sampah.');
    }

    public function restore($id)
    {
        $this->authorizeAdmin();

        DB::transaction(function () use ($id) {
            $sale = Sale::onlyTrashed()->findOrFail($id);
            $sale->restore();
        });

        return redirect()->back()->with('success', 'Riwayat penjualan berhasil dipulihkan.');
    }

    public function forceDelete($id)
    {
        $this->authorizeAdmin();

        DB::transaction(function () use ($id) {
            $sale = Sale::onlyTrashed()->findOrFail($id);
            $sale->details()->delete();
            $sale->forceDelete();
        });

        return redirect()->back()->with('success', 'Riwayat penjualan berhasil dihapus permanen.');
    }

    public function bulkDestroy(Request $request)
    {
        $this->authorizeAdmin();

        $request->validate([
            'ids' => 'required|array|min:1',
            'ids.*' => 'exists:sales,id'
        ]);

        DB::transaction(function () use ($request) {
            Sale::whereIn('id', $request->ids)->delete();
        });

        return redirect()->back()->with('success', count($request->ids) . ' transaksi berhasil dipindahkan ke sampah.');
    }


    public function bulkRestore(Request $request)
    {
        $this->authorizeAdmin();

        $request->validate([
            'ids' => 'required|array|min:1',
            'ids.*' => 'exists:sales,id'
        ]);

        DB::transaction(function () use ($request) {
            Sale::onlyTrashed()->whereIn('id', $request->ids)->restore();
        });

        return redirect()->back()->with('success', count($request->ids) . ' transaksi berhasil dipulihkan.');
    }
}
