# Salin ke .env lalu isi nilainya:  cp .env.docker.example .env
APP_NAME=MediSync
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
# Generate: docker compose run --rm --no-deps -e APP_KEY=x app php artisan key:generate --show
APP_KEY=

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=medisync
DB_USERNAME=medisync
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
LOG_CHANNEL=stderr

GEMINI_API_KEY=
